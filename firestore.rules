rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    match /domains/{domainId} {
      allow read, write: if true;
    }

    match /mailboxes/{mailboxId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /team_users/{userId} {
      allow read, write: if true;
    }

    match /security_logs/{logId} {
      allow read, write: if true;
    }

    match /email_templates/{templateId} {
      allow read, write: if true;
    }

    match /system_data/{dataId} {
      allow read, write: if true;
    }

    match /integrations/{settingId} {
      allow read, write: if true;
    }

    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    match /support_templates/{templateId} {
      allow read, write: if true;
    }

    match /support_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
